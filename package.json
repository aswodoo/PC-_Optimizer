{
  "name": "pc-optimizer",
  "version": "1.0.0",
  "description": "PC Optimizer and Monitor",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "build-react": "vite build",
    "pack": "electron-builder --dir"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "systeminformation": "^5.33.19"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "com.pcoptimizer.app",
    "productName": "PC Optimizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server.js",
      "electron.js",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "dir"
